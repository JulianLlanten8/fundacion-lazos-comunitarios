---
import Layout from '../layouts/Layout.astro';
import { DATOS_FUNDACION } from '../data/fundacion';
import Counter from '../components/Counter.astro';
import ProgramCard from '../components/ProgramCard.astro';
import PuzzleIcon from '../components/PuzzleIcon.astro';
import { Image } from 'astro:assets';

// Importación de fotos reales
import heroImg from '../assets/fotos/hero-comunidad.jpg';
import comedorImg from '../assets/fotos/comedor-almuerzos.jpg';
import huertaImg from '../assets/fotos/huerta-siembra.jpg';
import futbolImg from '../assets/fotos/futbol-equipo.jpg';
---

<Layout
  title={`${DATOS_FUNDACION.nombre} | ${DATOS_FUNDACION.lema}`}
  description="Fundación comunitaria en la comuna 13 de Cali. Seguridad alimentaria, educación ambiental, fútbol y valores y acompañamiento integral a personas mayores."
  paginaActual="/"
>
  <!-- SECCIÓN HERO -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 via-white to-white py-14 sm:py-20 lg:py-24">
    <!-- Decoración sutil de fondo -->
    <div class="pointer-events-none absolute -top-40 right-0 -z-10 h-96 w-96 rounded-full bg-blue-100/50 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute top-40 left-0 -z-10 h-96 w-96 rounded-full bg-emerald-100/40 blur-3xl" aria-hidden="true"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
        <!-- Texto del Hero -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2.5 rounded-full border border-slate-200 bg-white px-4 py-1.5 shadow-sm">
            <PuzzleIcon tamano={20} />
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-700">
              Comuna 13 · Santiago de Cali
            </span>
          </div>

          <h1 class="text-4xl font-extrabold tracking-tight text-brand-dark sm:text-5xl lg:text-6xl text-balance">
            {DATOS_FUNDACION.nombre}
          </h1>

          <p class="text-xl font-medium italic text-brand-blue sm:text-2xl">
            "{DATOS_FUNDACION.lema}"
          </p>

          <p class="max-w-2xl text-base text-slate-600 sm:text-lg leading-relaxed">
            Unidos desde el barrio Los Lagos I para nutrir vidas, cultivar el territorio, formar a la niñez en valores y dignificar a nuestros adultos mayores mediante el amor y la corresponsabilidad comunitaria.
          </p>

          <!-- 2 CTA Principales -->
          <div class="flex flex-col gap-3.5 sm:flex-row sm:justify-center lg:justify-start pt-2">
            <a
              href="/dona"
              class="inline-flex h-12 items-center justify-center rounded-full bg-brand-red px-8 text-base font-semibold text-white shadow-md transition-all duration-200 hover:bg-red-700 hover:shadow-lg focus-visible:ring-4 focus-visible:ring-red-400 touch-target"
            >
              <span>Dona hoy</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </a>
            <a
              href={DATOS_FUNDACION.contacto.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-12 items-center justify-center rounded-full border border-slate-300 bg-white px-7 text-base font-semibold text-slate-800 shadow-sm transition-all duration-200 hover:bg-slate-50 hover:text-emerald-700 hover:border-emerald-500 focus-visible:ring-4 focus-visible:ring-emerald-400 touch-target"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-5 w-5 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12c0 1.82.49 3.53 1.34 5.01L2 22l5.12-1.31C8.54 21.49 10.22 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm5.46 14.19c-.23.64-1.15 1.18-1.6 1.23-.42.05-.96.08-2.77-.66-2.18-.89-3.6-3.11-3.71-3.26-.11-.15-.88-1.17-.88-2.24 0-1.07.56-1.6.76-1.82.2-.22.44-.28.59-.28.15 0 .3 0 .43.01.14.01.32-.05.5.38.19.45.64 1.57.7 1.68.06.11.1.25.02.4-.07.15-.11.24-.22.37-.11.13-.23.29-.33.39-.11.11-.23.23-.1.45.13.22.58.96 1.25 1.56.86.77 1.59 1.01 1.81 1.12.22.11.36.09.49-.05.14-.15.58-.67.73-.91.16-.23.31-.2.53-.11.21.09 1.36.64 1.59.76.24.11.39.17.45.28.06.1.06.63-.17 1.27z" clip-rule="evenodd" />
              </svg>
              <span>Escríbenos por WhatsApp</span>
            </a>
          </div>
        </div>

        <!-- Imagen del Hero con motivo de rompecabezas -->
        <div class="lg:col-span-5">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Marco con esquinas redondeadas y sombra sólida -->
            <div class="relative overflow-hidden rounded-3xl border-4 border-white shadow-2xl">
              <Image
                src={heroImg}
                alt="Comunidad y lideresas de la Fundación Lazos Comunitarios en Cali"
                width={600}
                height={500}
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <p class="text-xs font-semibold uppercase tracking-wider text-emerald-300">
                  Comedor Comunitario Los Lagos I
                </p>
                <p class="text-sm font-medium text-slate-100">
                  Lideresas comunitarias sirviendo a su gente con dignidad y afecto.
                </p>
              </div>
            </div>

            <!-- Insignia flotante -->
            <div class="absolute -bottom-6 -left-6 hidden sm:flex items-center gap-3 rounded-2xl border border-slate-100 bg-white p-4 shadow-xl">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-50 text-brand-red">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Desde 2021</p>
                <p class="text-sm font-bold text-slate-800">Impacto diario real</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN DE CIFRAS DE IMPACTO (Animadas con Contador) -->
  <section class="border-y border-slate-200 bg-slate-900 py-16 text-white" aria-label="Cifras de impacto verificadas">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-sky">
          Cifras de Impacto Comunitario
        </h2>
        <p class="mt-2 text-3xl font-extrabold sm:text-4xl text-balance">
          Resultados transparentes que transforman el territorio
        </p>
        <p class="mt-3 text-slate-400 text-sm sm:text-base">
          Cada cifra refleja el esfuerzo articulado entre la comunidad, aliados y voluntarios en el oriente de Cali.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          DATOS_FUNDACION.metricas.map((metrica, idx) => (
            <div class="relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-800/60 p-6 text-center transition-all hover:border-slate-700 hover:bg-slate-800">
              <div class="text-4xl sm:text-5xl font-extrabold text-white">
                <Counter
                  valor={metrica.valor}
                  prefijo={metrica.prefijo}
                  sufijo={metrica.sufijo}
                  duracion={1600 + idx * 200}
                  clase={
                    idx === 0
                      ? 'text-red-400'
                      : idx === 1
                      ? 'text-emerald-400'
                      : idx === 2
                      ? 'text-sky-400'
                      : 'text-indigo-400'
                  }
                />
              </div>
              <p class="mt-3 text-base font-bold text-slate-100">
                {metrica.etiqueta}
              </p>
              <p class="mt-2 text-xs text-slate-400 leading-relaxed">
                {metrica.descripcion}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SECCIÓN 4 LÍNEAS DE ACCIÓN (Motivo Rompecabezas) -->
  <section id="programas" class="py-20 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1 border border-slate-200 text-xs font-semibold text-slate-700 shadow-sm">
          <PuzzleIcon tamano={18} />
          <span>Nuestros 4 Ejes Integrales</span>
        </div>
        <h2 class="mt-4 text-3xl font-extrabold text-brand-dark sm:text-4xl text-balance">
          Un rompecabezas donde cada pieza reconstruye el tejido social
        </h2>
        <p class="mt-3 text-base text-slate-600">
          La alimentación, la tierra, el deporte y el cuidado de los mayores no funcionan aislados: se articulan para transformar la comuna 13.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        {
          DATOS_FUNDACION.lineasAccion.map((linea) => (
            <ProgramCard linea={linea} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- SECCIÓN HISTORIA Y TERRITORIO RESUMIDA -->
  <section class="reveal py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Fotos compuestas -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="overflow-hidden rounded-2xl shadow-md">
              <Image
                src={comedorImg}
                alt="Entrega diaria de raciones calientes en el comedor comunitario"
                width={300}
                height={350}
                class="h-48 w-full object-cover transition-transform duration-300 hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="overflow-hidden rounded-2xl shadow-md">
              <Image
                src={huertaImg}
                alt="Niños y comunidad sembrando en la huerta urbana"
                width={300}
                height={260}
                class="h-36 w-full object-cover transition-transform duration-300 hover:scale-105"
                loading="lazy"
              />
            </div>
          </div>
          <div class="space-y-4 pt-6">
            <div class="overflow-hidden rounded-2xl shadow-md">
              <Image
                src={futbolImg}
                alt="Niños del equipo de fútbol formativo Lazos Comunitarios F.C."
                width={300}
                height={260}
                class="h-36 w-full object-cover transition-transform duration-300 hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="rounded-2xl bg-brand-blue p-6 text-white shadow-md">
              <p class="text-3xl font-extrabold">2021</p>
              <p class="mt-1 text-xs font-medium text-blue-200">
                Fundación oficial y apertura del comedor comunitario en Los Lagos I.
              </p>
            </div>
          </div>
        </div>

        <!-- Texto de Historia -->
        <div class="space-y-6">
          <span class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3.5 py-1 text-xs font-semibold text-brand-blue">
            Nuestra Historia
          </span>
          <h2 class="text-3xl font-extrabold tracking-tight text-brand-dark sm:text-4xl text-balance">
            Nacidos en el corazón de Los Lagos I para sembrar dignidad
          </h2>
          <p class="text-slate-600 leading-relaxed text-base">
            La <strong>Fundación Lazos Comunitarios</strong> nació legalmente el <strong>3 de enero de 2021</strong>, inaugurando su primer comedor comunitario el <strong>4 de abril de 2021</strong> en el barrio Los Lagos I, comuna 13 del oriente de Cali.
          </p>
          <p class="text-slate-600 leading-relaxed text-base">
            Lo que comenzó como una respuesta urgente ante las necesidades alimentarias se convirtió rápidamente en un ecosistema integral: huertas urbanas agroecológicas, una escuela deportiva para más de 40 niños y redes afectivas de cuidado para nuestros abuelos y abuelas.
          </p>

          <div class="pt-2">
            <a
              href="/nosotros"
              class="inline-flex items-center font-semibold text-brand-blue hover:text-blue-800 transition-colors gap-2"
            >
              <span>Conoce nuestra misión, visión y valores completos</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN DE VIDEO: LA COMUNIDAD EN ACCIÓN -->
  <section class="py-20 bg-slate-900 text-white border-t border-slate-800" aria-label="Video institucional">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 rounded-full bg-slate-800 border border-slate-700 px-4 py-1 text-xs font-semibold text-brand-sky">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <span>Nuestra Comunidad en Acción</span>
        </div>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl text-balance">
          Vívelo con tus propios ojos: la fuerza de la unión comunitaria
        </h2>
        <p class="mt-3 text-slate-300 text-sm sm:text-base">
          Registro audiovisual real de nuestras jornadas de articulación comunitaria en el barrio Los Lagos I, comuna 13 de Cali.
        </p>
      </div>

      <div class="mx-auto max-w-4xl overflow-hidden rounded-3xl border-2 border-slate-700 bg-black shadow-2xl">
        <video
          controls
          playsinline
          preload="metadata"
          poster="/videos/comunidad-poster.jpg"
          class="h-full w-full aspect-video object-cover"
          aria-label="Video de actividades comunitarias de la Fundación Lazos Comunitarios"
        >
          <source src="/videos/comunidad-en-accion.mp4" type="video/mp4" />
          Tu navegador no soporta la reproducción de video HTML5.
        </video>
      </div>
    </div>
  </section>

  <!-- LLAMADO A DONAR O SER VOLUNTARIO (Banner de Acción) -->
  <section class="relative overflow-hidden bg-gradient-to-r from-brand-blue to-blue-900 py-16 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center justify-between gap-8 lg:flex-row">
        <div class="max-w-2xl text-center lg:text-left">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-sky">
            Tu apoyo hace la diferencia
          </span>
          <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl text-balance">
            Ayúdanos a mantener vivo el comedor y las huertas comunitarias
          </h2>
          <p class="mt-3 text-blue-100 text-sm sm:text-base leading-relaxed">
            Puedes apoyar con donaciones económicas vía Nequi, alimentos e implementos en especie, o sumando tus manos y corazón como voluntario.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 shrink-0">
          <a
            href="/dona"
            class="inline-flex h-12 items-center justify-center rounded-full bg-brand-red px-7 text-base font-semibold text-white shadow-md transition-all hover:bg-red-700 hover:shadow-lg focus-visible:ring-4 focus-visible:ring-red-300 touch-target"
          >
            Donar por Nequi / Especie
          </a>
          <a
            href="/dona#voluntariado"
            class="inline-flex h-12 items-center justify-center rounded-full border border-white/40 bg-white/10 px-7 text-base font-semibold text-white backdrop-blur-sm transition-all hover:bg-white hover:text-brand-blue focus-visible:ring-4 focus-visible:ring-white touch-target"
          >
            Ser Voluntario
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

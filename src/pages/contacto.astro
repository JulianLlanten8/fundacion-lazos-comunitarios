---
import Layout from '../layouts/Layout.astro';
import { DATOS_FUNDACION } from '../data/fundacion';
import PuzzleIcon from '../components/PuzzleIcon.astro';
---

<Layout
  title={`Contacto y Ubicación | ${DATOS_FUNDACION.nombre}`}
  description="Ponte en contacto con la Fundación Lazos Comunitarios en el barrio Los Lagos I, comuna 13 de Cali. Escríbenos por WhatsApp o correo electrónico."
  paginaActual="/contacto"
>
  <!-- Encabezado de página -->
  <section class="bg-gradient-to-b from-blue-50/60 via-white to-white py-14 sm:py-20 border-b border-slate-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-blue-100 px-3.5 py-1 text-xs font-semibold text-brand-blue">
          <PuzzleIcon tamano={16} />
          <span>Atención y Canales</span>
        </span>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-brand-dark sm:text-5xl text-balance">
          Estamos en el barrio Los Lagos I, siempre dispuestos a escucharte
        </h1>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">
          Ya sea que desees realizar una donación, postularte como voluntario, proponer una alianza institucional o visitarnos, contáctanos por cualquiera de nuestros canales oficiales.
        </p>
      </div>
    </div>
  </section>

  <!-- Datos y Formulario -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- Columna Izquierda: Datos de Contacto y Mapa -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <h2 class="text-2xl font-bold text-brand-dark">
              Canales de Atención Directa
            </h2>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              Respondemos con la mayor agilidad a través de WhatsApp y correo institucional.
            </p>
          </div>

          <div class="space-y-5">
            <!-- Dirección -->
            <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-brand-blue">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Sede Principal</p>
                <p class="mt-1 text-sm font-semibold text-slate-800">
                  {DATOS_FUNDACION.ubicacion.direccion}
                </p>
                <p class="text-xs text-slate-600">
                  Barrio {DATOS_FUNDACION.ubicacion.barrio}, {DATOS_FUNDACION.ubicacion.comuna}
                </p>
                <p class="text-xs text-slate-500">
                  {DATOS_FUNDACION.ubicacion.ciudad}, Valle del Cauca, Colombia
                </p>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="flex items-start gap-4 rounded-2xl border border-emerald-100 bg-emerald-50/50 p-4">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-brand-green">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">WhatsApp / Celular</p>
                <p class="mt-1 text-sm font-semibold text-slate-800">
                  {DATOS_FUNDACION.contacto.telefonoVisual}
                </p>
                <a
                  href={DATOS_FUNDACION.contacto.whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 inline-flex items-center text-xs font-semibold text-brand-green hover:underline"
                >
                  Abrir conversación en WhatsApp →
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-100 text-brand-red">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Correo Electrónico</p>
                <p class="mt-1 text-sm font-semibold text-slate-800 truncate">
                  {DATOS_FUNDACION.contacto.email}
                </p>
                <a
                  href={`mailto:${DATOS_FUNDACION.contacto.email}`}
                  class="mt-1 inline-flex items-center text-xs font-semibold text-brand-red hover:underline"
                >
                  Enviar correo electrónico →
                </a>
              </div>
            </div>

            <!-- Instagram -->
            <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-purple-100 text-purple-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Instagram</p>
                <a
                  href={DATOS_FUNDACION.contacto.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 text-sm font-semibold text-purple-700 hover:underline block"
                >
                  {DATOS_FUNDACION.contacto.instagramUser}
                </a>
              </div>
            </div>
          </div>

          <!-- Mapa referencial -->
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
            <div class="p-4 bg-slate-100 border-b border-slate-200 flex items-center justify-between">
              <span class="text-xs font-bold text-slate-700">Ubicación: Los Lagos I, Cali</span>
              <a
                href="https://www.google.com/maps/search/?api=1&query=Cra+26T+72w-31+Cali"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold text-brand-blue hover:underline"
              >
                Abrir en Google Maps ↗
              </a>
            </div>
            <div class="h-56 w-full">
              <iframe
                title="Mapa de ubicación Fundación Lazos Comunitarios en Cali"
                src="https://www.openstreetmap.org/export/embed.html?bbox=-76.5100%2C3.4150%2C-76.4800%2C3.4350&layer=mapnik&marker=3.4255%2C-76.4952"
                class="h-full w-full border-0"
                loading="lazy"
              ></iframe>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Formulario de Contacto Accesible -->
        <div class="lg:col-span-7">
          <div class="rounded-3xl border border-slate-200 bg-white p-8 sm:p-10 shadow-sm">
            <h2 class="text-2xl font-bold text-brand-dark">
              Envíanos un mensaje
            </h2>
            <p class="mt-2 text-sm text-slate-600">
              Diligencia este formulario y nuestro equipo te responderá a la mayor brevedad.
            </p>

            <form
              id="form-contacto"
              action={`mailto:${DATOS_FUNDACION.contacto.email}`}
              method="GET"
              enctype="text/plain"
              class="mt-8 space-y-6"
            >
              <div>
                <label for="nombre" class="block text-sm font-semibold text-slate-700">
                  Nombre completo <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  name="nombre"
                  id="nombre"
                  required
                  placeholder="Tu nombre y apellido"
                  class="mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-800 placeholder-slate-400 shadow-sm transition-colors focus:border-brand-blue focus:ring-2 focus:ring-brand-blue touch-target"
                />
              </div>

              <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div>
                  <label for="telefono" class="block text-sm font-semibold text-slate-700">
                    Teléfono o WhatsApp <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="tel"
                    name="telefono"
                    id="telefono"
                    required
                    placeholder="Ej. 311 000 0000"
                    class="mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-800 placeholder-slate-400 shadow-sm transition-colors focus:border-brand-blue focus:ring-2 focus:ring-brand-blue touch-target"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-semibold text-slate-700">
                    Correo electrónico
                  </label>
                  <input
                    type="email"
                    name="email"
                    id="email"
                    placeholder="nombre@ejemplo.com"
                    class="mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-800 placeholder-slate-400 shadow-sm transition-colors focus:border-brand-blue focus:ring-2 focus:ring-brand-blue touch-target"
                  />
                </div>
              </div>

              <div>
                <label for="motivo" class="block text-sm font-semibold text-slate-700">
                  Motivo de contacto <span class="text-red-500">*</span>
                </label>
                <select
                  name="motivo"
                  id="motivo"
                  required
                  class="mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-800 shadow-sm transition-colors focus:border-brand-blue focus:ring-2 focus:ring-brand-blue touch-target"
                >
                  <option value="Donación económica o en especie">Deseo hacer una donación (dinero o especie)</option>
                  <option value="Voluntariado">Quiero ser voluntario</option>
                  <option value="Alianza institucional">Propuesta de alianza o apoyo institucional</option>
                  <option value="Información sobre programas">Información sobre comedor, huertas o fútbol</option>
                  <option value="Otro">Otro asunto</option>
                </select>
              </div>

              <div>
                <label for="mensaje" class="block text-sm font-semibold text-slate-700">
                  Mensaje <span class="text-red-500">*</span>
                </label>
                <textarea
                  name="mensaje"
                  id="mensaje"
                  rows="4"
                  required
                  placeholder="Cuéntanos en qué te gustaría colaborar o tu inquietud..."
                  class="mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-800 placeholder-slate-400 shadow-sm transition-colors focus:border-brand-blue focus:ring-2 focus:ring-brand-blue"
                ></textarea>
              </div>

              <div class="pt-2 flex flex-col sm:flex-row gap-4">
                <button
                  type="submit"
                  class="inline-flex h-12 flex-1 items-center justify-center rounded-full bg-brand-blue px-6 font-semibold text-white shadow-md transition-all hover:bg-blue-900 focus-visible:ring-4 focus-visible:ring-blue-300 touch-target"
                >
                  <span>Enviar por Correo</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>

                <button
                  type="button"
                  id="btn-enviar-wa"
                  class="inline-flex h-12 items-center justify-center rounded-full border border-emerald-600 bg-emerald-50 px-6 font-semibold text-emerald-800 transition-all hover:bg-emerald-600 hover:text-white focus-visible:ring-4 focus-visible:ring-emerald-300 touch-target"
                >
                  <span>Enviar por WhatsApp</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('form-contacto') as HTMLFormElement;
  const btnWA = document.getElementById('btn-enviar-wa');

  if (btnWA && form) {
    btnWA.addEventListener('click', () => {
      const nombre = (document.getElementById('nombre') as HTMLInputElement)?.value || '';
      const telefono = (document.getElementById('telefono') as HTMLInputElement)?.value || '';
      const motivo = (document.getElementById('motivo') as HTMLSelectElement)?.value || '';
      const mensaje = (document.getElementById('mensaje') as HTMLTextAreaElement)?.value || '';

      if (!nombre || !mensaje) {
        alert('Por favor completa al menos tu nombre y tu mensaje antes de enviar.');
        return;
      }

      const texto = `Hola, mi nombre es ${nombre} (Tel: ${telefono}). Me contacto por: *${motivo}*.\n\nMensaje: ${mensaje}`;
      const url = `https://wa.me/573113036529?text=${encodeURIComponent(texto)}`;
      window.open(url, '_blank');
    });
  }
</script>

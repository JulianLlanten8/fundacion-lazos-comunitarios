---
import Layout from '../layouts/Layout.astro';
import { DATOS_FUNDACION } from '../data/fundacion';
import PuzzleIcon from '../components/PuzzleIcon.astro';
import { Image } from 'astro:assets';

import lideresasImg from '../assets/fotos/comunidad-lideresas.jpg';
import adultosImg from '../assets/fotos/adulto-mayor-sonrisas.jpg';
---

<Layout
  title={`Quiénes Somos | ${DATOS_FUNDACION.nombre}`}
  description="Conoce la historia, misión, visión y valores de la Fundación Lazos Comunitarios en el oriente de Cali."
  paginaActual="/nosotros"
>
  <!-- Encabezado de página -->
  <section class="bg-gradient-to-b from-blue-50/50 via-white to-white py-14 sm:py-20 border-b border-slate-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-blue-100/80 px-3.5 py-1 text-xs font-semibold text-brand-blue">
          <PuzzleIcon tamano={16} />
          <span>Nuestra Identidad</span>
        </span>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-brand-dark sm:text-5xl text-balance">
          Construyendo redes de dignidad y esperanza comunitaria
        </h1>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">
          Somos una organización comunitaria independiente nacida en el barrio Los Lagos I, comuna 13 del oriente de Cali, comprometida con transformar realidades desde la empatía y la autogestión.
        </p>
      </div>
    </div>
  </section>

  <!-- Historia detallada -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6 space-y-5">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-blue">
            Origen y Trayectoria
          </span>
          <h2 class="text-3xl font-extrabold text-brand-dark sm:text-4xl text-balance">
            Desde el 3 de enero de 2021 tejiendo comunidad
          </h2>
          <p class="text-slate-600 leading-relaxed">
            La <strong>Fundación Lazos Comunitarios</strong> se constituyó oficialmente el <strong>3 de enero de 2021</strong> (NIT 901 606 417-8) con la convicción de que la transformación social florece cuando la misma comunidad toma el liderazgo de su territorio.
          </p>
          <p class="text-slate-600 leading-relaxed">
            El <strong>4 de abril de 2021</strong> abrimos las puertas de nuestro primer <strong>Comedor Comunitario</strong> en la Carrera 26 T # 72 w - 31, barrio Los Lagos I. Desde ese momento, lideresas de la comuna se convirtieron en las guardianas nutricionales de decenas de niños, madres y personas de la tercera edad en situación de vulnerabilidad extrema.
          </p>
          <p class="text-slate-600 leading-relaxed">
            Con el paso del tiempo, el comedor abrió paso a las <strong>Huertas Urbanas</strong>, a la escuela formativa <strong>Lazos Comunitarios F.C.</strong> y a un programa integral de envejecimiento activo que protege la salud emocional de nuestros adultos mayores.
          </p>
        </div>

        <div class="lg:col-span-6">
          <div class="relative overflow-hidden rounded-3xl border-4 border-white shadow-xl">
            <Image
              src={lideresasImg}
              alt="Lideresas de la Fundación Lazos Comunitarios en Los Lagos I"
              width={600}
              height={450}
              class="h-full w-full object-cover"
              loading="lazy"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/70 p-6 text-white">
              <p class="font-bold text-base">Liderazgo Femenino Comunitario</p>
              <p class="text-xs text-slate-200">
                Lideresas del oriente de Cali impulsando la gestión alimentaria y el cuidado mutuo.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Misión y Visión (Bloques destacados) -->
  <section class="py-16 bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        <!-- Tarjeta Misión -->
        <div class="rounded-3xl border border-blue-100 bg-white p-8 sm:p-10 shadow-sm transition-all hover:shadow-md">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-brand-blue">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h2 class="mt-6 text-2xl font-extrabold text-brand-dark sm:text-3xl">
            Misión Institucional
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            {DATOS_FUNDACION.mision}
          </p>
        </div>

        <!-- Tarjeta Visión -->
        <div class="rounded-3xl border border-emerald-100 bg-white p-8 sm:p-10 shadow-sm transition-all hover:shadow-md">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 text-brand-green">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <h2 class="mt-6 text-2xl font-extrabold text-brand-dark sm:text-3xl">
            Visión hacia 2030
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            {DATOS_FUNDACION.vision}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valores Institucionales (5 valores del documento docx) -->
  <section class="py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-blue">
          Nuestros Principios Rectores
        </span>
        <h2 class="mt-2 text-3xl font-extrabold text-brand-dark sm:text-4xl text-balance">
          Valores que guían cada acción cotidiana
        </h2>
        <p class="mt-3 text-slate-600">
          Actuamos bajo una estricta ética comunitaria de transparencia, cercanía humana y respeto absoluto por la vida.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          DATOS_FUNDACION.valores.map((valor, i) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition-all hover:border-brand-blue/30 hover:shadow-md">
              <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 font-bold text-brand-blue text-sm">
                  0{i + 1}
                </span>
                <h3 class="text-lg font-bold text-brand-dark">
                  {valor.titulo}
                </h3>
              </div>
              <p class="mt-4 text-sm text-slate-600 leading-relaxed">
                {valor.descripcion}
              </p>
            </div>
          ))
        }

        <!-- Tarjeta especial: Alianzas y Respaldo -->
        <div class="rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-900 to-blue-950 p-7 text-white shadow-sm flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-brand-sky">
              Red Interinstitucional
            </span>
            <h3 class="mt-2 text-lg font-bold text-white">
              Trabajo Articulado
            </h3>
            <p class="mt-3 text-xs text-slate-300 leading-relaxed">
              Junto a la Alcaldía de Cali, Pastoral Social, FUPAD, Universidad Nacional de Colombia (Palmira) y Fundación SIDOC.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-800">
            <a href="/dona" class="text-xs font-semibold text-brand-sky hover:underline flex items-center gap-1">
              <span>Súmate como aliado o voluntario</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

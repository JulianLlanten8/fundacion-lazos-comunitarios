---
import Layout from '../layouts/Layout.astro';
import { DATOS_FUNDACION } from '../data/fundacion';
import PuzzleIcon from '../components/PuzzleIcon.astro';
---

<Layout
  title={`Cómo Apoyar y Donar | ${DATOS_FUNDACION.nombre}`}
  description="Dona dinero por Nequi, alimentos en especie o tiempo como voluntario en la Fundación Lazos Comunitarios en Cali. Certificados de donación disponibles."
  paginaActual="/dona"
>
  <!-- Encabezado de página -->
  <section class="bg-gradient-to-b from-red-50/60 via-white to-white py-14 sm:py-20 border-b border-slate-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-red-100 px-3.5 py-1 text-xs font-semibold text-brand-red">
          <PuzzleIcon tamano={16} piezaActiva="rojo" />
          <span>Solidaridad Comunitaria</span>
        </span>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-brand-dark sm:text-5xl text-balance">
          Tu generosidad alimenta la esperanza en el oriente de Cali
        </h1>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">
          Cada aporte, plato de comida, juguete o minuto de voluntariado llega directamente a los niños, lideresas y abuelos del barrio Los Lagos I.
        </p>
      </div>
    </div>
  </section>

  <!-- 3 Formas de Donar / Apoyar -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        <!-- Tarjeta 1: Donación Monetaria / Nequi -->
        <div class="flex flex-col justify-between rounded-3xl border-2 border-brand-red/30 bg-white p-8 shadow-md transition-all hover:border-brand-red hover:shadow-xl">
          <div>
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-red-50 text-brand-red">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h2 class="mt-6 text-2xl font-bold text-brand-dark">
              1. Aporte Económico
            </h2>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              Tus donaciones permiten adquirir alimentos frescos en el mercado local, insumos de cocina y materiales deportivos para la niñez.
            </p>

            <!-- Caja Nequi -->
            <div class="mt-6 rounded-2xl bg-slate-900 p-5 text-white">
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wider text-purple-300">Nequi / Bancolombia</span>
                <span class="rounded bg-purple-900/60 px-2 py-0.5 text-[10px] font-bold text-purple-200">Oficial</span>
              </div>
              <p class="mt-2 text-2xl font-extrabold tracking-wider text-white">
                {DATOS_FUNDACION.contacto.nequi}
              </p>
              <p class="mt-1 text-xs text-slate-300">
                A nombre de: Fundación Lazos Comunitarios (NIT {DATOS_FUNDACION.nit})
              </p>
              <button
                type="button"
                id="btn-copiar-nequi"
                data-numero={DATOS_FUNDACION.contacto.nequi}
                class="mt-4 flex items-center justify-center gap-2 w-full rounded-xl bg-purple-600/30 border border-purple-400/40 py-2.5 px-3 text-xs font-semibold text-purple-200 transition-all hover:bg-purple-600 hover:text-white touch-target"
                aria-label="Copiar número de Nequi al portapapeles"
              >
                <svg id="icon-copy" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span id="text-copy">Copiar número de cuenta</span>
              </button>
            </div>
          </div>

          <div class="mt-8 pt-4">
            <a
              href={`${DATOS_FUNDACION.contacto.whatsapp}&text=Hola%2C%20acabo%20de%20realizar%20una%20donaci%C3%B3n%20por%20Nequi%20y%20quiero%20enviar%20mi%20comprobante`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-12 w-full items-center justify-center rounded-full bg-brand-red font-semibold text-white transition-colors hover:bg-red-700 touch-target shadow-sm"
            >
              Enviar comprobante por WhatsApp
            </a>
          </div>
        </div>

        <!-- Tarjeta 2: Donación en Especie -->
        <div class="flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-8 shadow-sm transition-all hover:border-brand-green/50 hover:shadow-lg">
          <div>
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 text-brand-green">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <h2 class="mt-6 text-2xl font-bold text-brand-dark">
              2. Donación en Especie
            </h2>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              Recibimos directamente en nuestra sede comunitaria elementos esenciales para nuestros programas:
            </p>

            <ul class="mt-4 space-y-2.5 text-xs text-slate-600">
              <li class="flex items-start gap-2">
                <span class="text-brand-green font-bold">✓</span>
                <span><strong>Alimentos no perecederos:</strong> Arroz, lentejas, frijoles, aceite, sal, azúcar, pastas y avena.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-green font-bold">✓</span>
                <span><strong>Alimentos frescos:</strong> Frutas, verduras y proteínas para el comedor diario.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-green font-bold">✓</span>
                <span><strong>Implementos deportivos:</strong> Balones de fútbol, uniformes, conos y petos para los niños del club.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-green font-bold">✓</span>
                <span><strong>Ropa y juguetes:</strong> Ropa en buen estado para los pulgueros y juguetes para actividades navideñas y de la infancia.</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-4">
            <a
              href={`${DATOS_FUNDACION.contacto.whatsapp}&text=Hola%2C%20quiero%20coordinar%20una%20entrega%20de%20donaci%C3%B3n%20en%20especie`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-12 w-full items-center justify-center rounded-full border border-slate-300 bg-white font-semibold text-slate-700 transition-colors hover:bg-slate-50 touch-target"
            >
              Coordinar entrega en sede
            </a>
          </div>
        </div>

        <!-- Tarjeta 3: Voluntariado -->
        <div id="voluntariado" class="flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-8 shadow-sm transition-all hover:border-brand-sky/50 hover:shadow-lg">
          <div>
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-sky-50 text-brand-sky">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <h2 class="mt-6 text-2xl font-bold text-brand-dark">
              3. Tiempo y Voluntariado
            </h2>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              Tus talentos y vocación de servicio son invaluables para nuestra comunidad:
            </p>

            <ul class="mt-4 space-y-2.5 text-xs text-slate-600">
              <li class="flex items-start gap-2">
                <span class="text-brand-sky font-bold">✓</span>
                <span><strong>Apoyo pedagógico y talleres:</strong> Actividades lúdicas y artísticas para la primera infancia.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-sky font-bold">✓</span>
                <span><strong>Entrenamiento deportivo:</strong> Acompañamiento a los entrenamientos de Lazos Comunitarios F.C.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-sky font-bold">✓</span>
                <span><strong>Manos en la huerta:</strong> Apoyo en siembra, deshierbe y mantenimiento agroecológico.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-sky font-bold">✓</span>
                <span><strong>Cuidado del adulto mayor:</strong> Talleres de salud emocional, recreación y escucha activa.</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-4">
            <a
              href={`${DATOS_FUNDACION.contacto.whatsapp}&text=Hola%2C%20quiero%20postularme%20como%20voluntario%20de%20la%20Fundaci%C3%B3n`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-12 w-full items-center justify-center rounded-full bg-brand-blue font-semibold text-white transition-colors hover:bg-blue-900 touch-target"
            >
              Postularme como voluntario
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Certificados de Donación y Transparencia -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-white p-8 sm:p-12 border border-slate-200 shadow-sm">
        <div class="grid items-center gap-8 md:grid-cols-12">
          <div class="md:col-span-8 space-y-3">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-brand-green">
              Transparencia Institucional
            </span>
            <h3 class="text-2xl font-extrabold text-brand-dark sm:text-3xl">
              Certificados de Donación Oficiales
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              La <strong>Fundación Lazos Comunitarios</strong> está legalmente constituida ante la Cámara de Comercio de Cali con el <strong>NIT 901 606 417-8</strong>. Expedimos certificados oficiales de donación para personas naturales y empresas que requieran soporte fiscal y tributario.
            </p>
            <p class="text-xs text-slate-500">
              Para solicitar tu certificado, escríbenos a nuestro correo <a href={`mailto:${DATOS_FUNDACION.contacto.email}`} class="text-brand-blue underline">{DATOS_FUNDACION.contacto.email}</a> adjuntando tu comprobante y datos del RUT.
            </p>
          </div>

          <div class="md:col-span-4 text-center md:text-right">
            <a
              href={`mailto:${DATOS_FUNDACION.contacto.email}?subject=Solicitud%20de%20Certificado%20de%20Donaci%C3%B3n`}
              class="inline-flex h-12 items-center justify-center rounded-full border-2 border-brand-dark bg-white px-7 text-sm font-bold text-brand-dark transition-colors hover:bg-brand-dark hover:text-white touch-target"
            >
              Solicitar certificado
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupCopiado() {
    const btn = document.getElementById('btn-copiar-nequi');
    const textCopy = document.getElementById('text-copy');
    if (btn && textCopy) {
      btn.addEventListener('click', async () => {
        const numero = btn.dataset.numero || '';
        try {
          await navigator.clipboard.writeText(numero.replace(/\s+/g, ''));
          const original = textCopy.textContent;
          textCopy.textContent = '¡Copiado con éxito! ✓';
          btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-400');
          setTimeout(() => {
            textCopy.textContent = original;
            btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-400');
          }, 2000);
        } catch (e) {
          console.error('Error al copiar', e);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', setupCopiado);
</script>

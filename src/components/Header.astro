---
import { DATOS_FUNDACION, MENU_NAVEGACION } from '../data/fundacion';
import { Image } from 'astro:assets';
import logoImg from '../assets/logos/logo-horizontal-transparente.png';

interface Props {
  paginaActual?: string;
}

const { paginaActual = '/' } = Astro.props;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-md transition-all">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-3 touch-target" aria-label="Ir a la página de inicio">
      <Image
        src={logoImg}
        alt="Logo Fundación Lazos Comunitarios"
        width={210}
        height={60}
        class="h-12 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
        loading="eager"
      />
    </a>

    <!-- Navegación de escritorio -->
    <nav class="hidden md:flex md:items-center md:gap-7" aria-label="Navegación principal">
      {
        MENU_NAVEGACION.map((item) => (
          <a
            href={item.ruta}
            class:list={[
              'text-[15px] font-medium transition-colors hover:text-brand-blue py-2',
              paginaActual === item.ruta
                ? 'text-brand-blue font-semibold border-b-2 border-brand-blue'
                : 'text-slate-700',
            ]}
            aria-current={paginaActual === item.ruta ? 'page' : undefined}
          >
            {item.nombre}
          </a>
        ))
      }
    </nav>

    <!-- Botón CTA Dona en desktop -->
    <div class="hidden items-center gap-4 md:flex">
      <a
        href="/dona"
        class="inline-flex h-11 items-center justify-center rounded-full bg-brand-red px-6 text-sm font-semibold text-white shadow-sm transition-all hover:bg-red-700 hover:shadow-md focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2 touch-target"
      >
        <span>Dona ahora</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      </a>
    </div>

    <!-- Botón menú móvil -->
    <div class="flex items-center md:hidden">
      <button
        type="button"
        id="btn-menu-movil"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-slate-700 hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-brand-blue touch-target"
        aria-controls="menu-movil"
        aria-expanded="false"
        aria-label="Abrir menú de navegación"
      >
        <svg id="icono-hamburguesa" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icono-cerrar" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Panel Menú Móvil -->
  <div
    id="menu-movil"
    class="hidden border-b border-slate-200 bg-white px-4 pb-6 pt-2 md:hidden"
    aria-label="Menú móvil"
  >
    <div class="flex flex-col space-y-3">
      {
        MENU_NAVEGACION.map((item) => (
          <a
            href={item.ruta}
            class:list={[
              'rounded-lg px-3 py-3 text-base font-medium transition-colors touch-target flex items-center',
              paginaActual === item.ruta
                ? 'bg-blue-50 text-brand-blue font-semibold'
                : 'text-slate-700 hover:bg-slate-50 hover:text-brand-blue',
            ]}
          >
            {item.nombre}
          </a>
        ))
      }
      <div class="pt-3">
        <a
          href="/dona"
          class="flex h-12 w-full items-center justify-center rounded-xl bg-brand-red text-center font-semibold text-white shadow-sm transition-colors hover:bg-red-700 touch-target"
        >
          Dona ahora
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btnMenu = document.getElementById('btn-menu-movil');
  const menuMovil = document.getElementById('menu-movil');
  const iconoHamburguesa = document.getElementById('icono-hamburguesa');
  const iconoCerrar = document.getElementById('icono-cerrar');

  if (btnMenu && menuMovil && iconoHamburguesa && iconoCerrar) {
    btnMenu.addEventListener('click', () => {
      const estaAbierto = btnMenu.getAttribute('aria-expanded') === 'true';
      btnMenu.setAttribute('aria-expanded', String(!estaAbierto));
      menuMovil.classList.toggle('hidden');
      iconoHamburguesa.classList.toggle('hidden');
      iconoCerrar.classList.toggle('hidden');
    });

    // Cerrar menú al hacer clic en un enlace
    menuMovil.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        btnMenu.setAttribute('aria-expanded', 'false');
        menuMovil.classList.add('hidden');
        iconoHamburguesa.classList.remove('hidden');
        iconoCerrar.classList.add('hidden');
      });
    });
  }
</script>

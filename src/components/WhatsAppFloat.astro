  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl transition-all duration-200 hover:scale-110 hover:bg-[#20ba59] hover:shadow-2xl focus-visible:ring-4 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 touch-target"
  aria-label={`Escríbenos por WhatsApp al ${DATOS_FUNDACION.contacto.telefonoVisual}`}

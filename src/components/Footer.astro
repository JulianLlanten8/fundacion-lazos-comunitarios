---
import { DATOS_FUNDACION } from '../data/fundacion';
import { Image } from 'astro:assets';
import logoVertical from '../assets/logos/logo-vertical.jpg';

const anioActual = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-900 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Columna 1: Identidad y Lema -->
      <div class="space-y-4">
        <div class="inline-block rounded-xl bg-white p-3 shadow-sm">
          <Image
            src={logoVertical}
            alt="Fundación Lazos Comunitarios"
            width={160}
            height={80}
            class="h-16 w-auto object-contain"
            loading="lazy"
          />
        </div>
        <p class="text-sm font-medium italic text-slate-200">
          "{DATOS_FUNDACION.lema}"
        </p>
        <p class="text-xs text-slate-400 leading-relaxed">
          Organización comunitaria sin ánimo de lucro transformando realidades en el oriente de Cali desde 2021.
        </p>
        <div class="pt-2 text-xs text-slate-400">
          <p><span class="font-semibold text-slate-300">NIT:</span> {DATOS_FUNDACION.nit}</p>
          <p><span class="font-semibold text-slate-300">Personería Jurídica:</span> Entidad legalmente constituida</p>
          <p><span class="font-semibold text-slate-300">Representante:</span> {DATOS_FUNDACION.representanteLegal}</p>
        </div>
      </div>

      <!-- Columna 2: Líneas de Acción -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          Líneas de Acción
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            DATOS_FUNDACION.lineasAccion.map((linea) => (
              <li>
                <a
                  href={`/programas/${linea.slug}`}
                  class="transition-colors hover:text-white flex items-center gap-2"
                >
                  <span class="h-2 w-2 rounded-full" style={`background-color: ${linea.color};`}></span>
                  <span>{linea.titulo}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 3: Enlaces Rápidos y Apoyo -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          Participa y Apoya
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href="/nosotros" class="transition-colors hover:text-white">
              Nuestra Historia y Misión
            </a>
          </li>
          <li>
            <a href="/dona" class="transition-colors hover:text-white font-medium text-red-400 hover:text-red-300">
              Cómo Donar (Nequi / Especie)
            </a>
          </li>
          <li>
            <a href="/dona#voluntariado" class="transition-colors hover:text-white">
              Ser Voluntario / Tiempos de Cuidado
            </a>
          </li>
          <li>
            <a href="/contacto" class="transition-colors hover:text-white">
              Canales de Contacto
            </a>
          </li>
          <li>
            <a
              href={DATOS_FUNDACION.contacto.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-emerald-400 flex items-center gap-1.5"
            >
              <span>Escríbenos por WhatsApp</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Ubicación y Contacto -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          Sede Principal
        </h3>
        <div class="mt-4 space-y-3 text-sm text-slate-300">
          <p class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-brand-sky mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>
              {DATOS_FUNDACION.ubicacion.direccion}<br />
              {DATOS_FUNDACION.ubicacion.barrio}, {DATOS_FUNDACION.ubicacion.comuna}<br />
              {DATOS_FUNDACION.ubicacion.ciudad}, {DATOS_FUNDACION.ubicacion.pais}
            </span>
          </p>
          <p class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-brand-green" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>WhatsApp / Nequi: {DATOS_FUNDACION.contacto.telefonoVisual}</span>
          </p>
          <p class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="break-all">{DATOS_FUNDACION.contacto.email}</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="mt-12 border-t border-slate-800 pt-8 text-center text-xs text-slate-400 md:flex md:items-center md:justify-between md:text-left">
      <p>
        &copy; {anioActual} {DATOS_FUNDACION.nombre}. Todos los derechos reservados.
      </p>
      <p class="mt-3 md:mt-0 text-[11px] text-slate-400 max-w-xl">
        Compromiso de protección integral: Las imágenes publicadas han sido autorizadas en el marco de las actividades comunitarias de la fundación.
      </p>
    </div>
  </div>
</footer>
